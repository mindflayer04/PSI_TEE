enclave {
  trusted {
    public sgx_status_t ecall_createMap(
        [in, count=set_size] const __uint128_t* input_set, 
        size_t set_size
    );

    public sgx_status_t ecall_insert_element(__uint128_t element);

    public sgx_status_t ecall_delete_element(__uint128_t element);

    public sgx_status_t ecall_insert_batch(
      [in, count=num_elements] const __uint128_t* elements,
      uint32_t num_elements
    );

    public sgx_status_t ecall_delete_batch(
      [in, count=num_elements] const __uint128_t* elements,
      uint32_t num_elements
    );


    public uint32_t ecall_get_rsa_sealed_size();

    public sgx_status_t ecall_generate_rsa_key(
      [out, size=sealed_size] uint8_t* p_sealed_buffer,
      uint32_t sealed_size,
      [out, size=256] uint8_t* p_public_modulus
    );

    public sgx_status_t ecall_check_decryption(
      [in,size=sealed_size]const uint8_t* p_sealed_buffer,
      uint32_t sealed_size,
      [in,size=256]const uint8_t* ciphertext
    );

    public sgx_status_t ecall_check_intersection(
      [in,size=sealed_size] const uint8_t* p_sealed_buffer,
      uint32_t sealed_size,
      [in,size=256] const uint8_t* ciphertext,
      [out, size=1] uint8_t* found
    );

    public sgx_status_t ecall_check_intersection_batch(
      [in,size=sealed_size] const uint8_t* p_sealed_buffer,
      uint32_t sealed_size,
      [in, count=ciphertexts_size] const uint8_t* ciphertexts,
      uint32_t ciphertexts_size,
      uint32_t num_elements,
      [out, count=num_elements] uint8_t* found
    );
  };

  untrusted {
    void ocall_FAIL();
    void ocall_print_string([in, string] const char *str);
    uint64_t ocall_measure_time();
    uint8_t* ocall_InitServer(uint64_t sizeOfT, uint64_t N_);
    void ocall_DeleteServer();
    void ocall_Read_Batch(uint64_t batchSize, uint64_t pageBytes, uint64_t totalBytes, [in, count=batchSize] uint64_t* offsets,  [out, count=totalBytes] uint8_t* buffer);
    void ocall_Read(uint64_t pos, uint64_t length, [out, count=length] uint8_t* page);
    void ocall_Write_Batch(uint64_t batchSize, uint64_t pageBytes, uint64_t totalBytes, [in, count=batchSize] uint64_t* offsets,  [in, count=totalBytes] uint8_t* buffer);
    void ocall_Write(uint64_t pos, uint64_t length, [in, count=length] const uint8_t* page);
  };
};
